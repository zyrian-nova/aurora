# ENV variables
ENVIRONMENT=development # 'development' or 'production'
LOG_LEVEL=DEBUG # Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Allowed origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 # En lista

# Database connection
DATABASE_URL=postgresql://aurora_user:your_password_here@localhost:5432/aurora

# Redis connection
REDIS_URL=

# JWT
JWT_SECRET=very-secure-secret-token
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=360
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama hots and model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# External APIS
# Weather (website)
WEATHER_API_KEY=
NEWS_API_KEY=
